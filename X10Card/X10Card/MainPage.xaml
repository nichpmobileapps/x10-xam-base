<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="X10Card.MainPage"
              xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core" 
             ios:Page.UseSafeArea="true">
    
    <NavigationPage.TitleView  >
        <StackLayout  Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">

            <Image Source="ic_himachallogo.png"  HeightRequest="40"  VerticalOptions="CenterAndExpand"/>
            <StackLayout  Orientation="Vertical" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Spacing="0">

                <Label  Text="X10 (Registration Card)" Style="{StaticResource NavigationLabelColor}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center"
                      VerticalTextAlignment="Center" />

            </StackLayout>
        </StackLayout>
    </NavigationPage.TitleView>


    <Grid>
        <StackLayout Margin="9">
            <ScrollView VerticalOptions ="FillAndExpand">
                <StackLayout>

                    <StackLayout VerticalOptions ="FillAndExpand">
                        <Frame  CornerRadius="10" BackgroundColor="White" BorderColor="Silver"  Padding="10" VerticalOptions="FillAndExpand">
                            <StackLayout>
                                <StackLayout>
                                    <Image Source="ic_launcher.png" x:Name="img_launcher" HorizontalOptions="Center" HeightRequest="110"/>
                                    <Label Text="Department Of Labour And Employment&#10; Government Of Himachal Pradesh" HorizontalOptions="CenterAndExpand" 
                                    HorizontalTextAlignment="Center" TextColor="Navy" FontSize="20" FontAttributes="Bold"/>
                                </StackLayout>

                                <StackLayout>
                                    <Label Text="The X10 Registration Card mobile application is useful for the various unemployed youth's who are registered at various Employment Exchanges of Himachal Pradesh."
                                     HorizontalOptions="FillAndExpand"  TextColor="Black" FontSize="16" />

                                    <Label Text="The X10 Registration Card mobile app offers the following functionalities to the candidates : 
                                      &#10;➤ Candidate can self register/sign up and activate the account &amp; can fill all the required registration forms.
                                      &#10;➤ Candidate can view the personal, contact , qualification and other details.
                                      &#10;➤ Candidate can view the relevant vacancy information, if available, matching his/her qualifications.
                                      &#10;➤ Candidate can view the sponsorship details for recruitment to various vacancies published.  
                                      &#10;➤ Candidate can view the details of different allowances provided to him, if any.  
                                      &#10;➤ Candidate can view the Job Fairs, if any.  
                                      &#10;➤ Candidate can update his/her employment status." 
                                      HorizontalOptions="FillAndExpand"  TextColor="Black" FontSize="16" />
                                </StackLayout>
                            </StackLayout>
                        </Frame>
                    </StackLayout>
                </StackLayout>
            </ScrollView>
            <Button VerticalOptions="End"  x:Name="btn_submit" FontSize="18" Text="Proceed For Login &amp; Registration"   BackgroundColor="#058ef2"  TextColor="White" CornerRadius="15"  HorizontalOptions="Center" Clicked="btn_submit_Clicked" Padding="5" FontAttributes="Bold"/>

            <StackLayout Orientation="Vertical" Margin="10,5,10,5" HorizontalOptions="FillAndExpand"   >
                <Label Text="Centre Of Competence For Mobile Application Development NIC Himachal Pradesh" FontSize="14" Padding="5" BackgroundColor="White" TextColor="Navy" HorizontalTextAlignment="Center" FontAttributes="Bold"></Label>
            </StackLayout>
        </StackLayout>


        <ContentView x:Name="Loading_activity" BackgroundColor="#C0808080" Padding="20, 20" IsVisible="false" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Frame BackgroundColor="White" HorizontalOptions="FillAndExpand">
                    <StackLayout Orientation="Horizontal" Margin="6" HorizontalOptions="FillAndExpand">
                        <ActivityIndicator IsVisible="true" IsRunning="true" Margin="5"/>
                        <Label x:Name="lbl_PleaseWait" Text="Please Wait ..." TextColor="Black" FontAttributes="Bold" HorizontalOptions="FillAndExpand" WidthRequest="600" VerticalTextAlignment="Center"/>
                    </StackLayout>
                </Frame>
            </StackLayout>
        </ContentView>
    </Grid>

</ContentPage>
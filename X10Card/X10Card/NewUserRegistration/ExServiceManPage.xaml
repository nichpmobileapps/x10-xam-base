<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="X10Card.NewUserRegistration.ExServiceManPage"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core" 
             ios:Page.UseSafeArea="true"  >
    <NavigationPage.TitleView  >
        <StackLayout  Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" >

            <Image Source="ic_himachallogo.png"  HeightRequest="40"  VerticalOptions="CenterAndExpand"/>
            <StackLayout  Orientation="Vertical" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Spacing="0">
                <Label x:Name="lbl_navigation_header1" Style="{StaticResource NavigationLabelColor}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center"
                    Text="Department Of Labour &amp; Employment"  VerticalTextAlignment="Center" />
                <Label x:Name="lbl_navigation_header"  Style="{StaticResource NavigationLabelColor}"  FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />

            </StackLayout>
        </StackLayout>
    </NavigationPage.TitleView>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="ic_home.png" Clicked="ToolbarItem_Clicked" ></ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
        <StackLayout Margin="9">
            <Button x:Name="btn_header" CornerRadius="10"  Text="Ex-ServiceMen Details" HorizontalOptions="FillAndExpand"  TextColor="White" BackgroundColor="Navy" FontSize="16" FontAttributes="Bold"/>
            <Label Text="*Fields marked are mandatory" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="Navy" FontSize="14" />

            <ScrollView VerticalOptions ="FillAndExpand">
                <StackLayout>
                   
                    <Frame  CornerRadius="10"  BorderColor="#058ef2" VerticalOptions="FillAndExpand" >
                        
                        <StackLayout  Orientation="Vertical" >

                            <Label Text="FORCE NAME *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Picker TextColor="Black" TitleColor="Black" Title="SELECT FORCE NAME" x:Name="picker_FORCENAME" SelectedIndexChanged="picker_FORCENAME_SelectedIndexChanged"/>

                            <Label Text="RANK *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Picker TextColor="Black" TitleColor="Black" Title="SELECT RANK" x:Name="picker_RANK" SelectedIndexChanged="picker_RANK_SelectedIndexChanged"/>


                            <Label Text="REGIMENT NAME *" TextColor="Navy" FontSize="16" FontAttributes="Bold" />
                            <Entry x:Name="entry_REGIMENTNAME" Placeholder="ENTER REGIMENT NAME" MaxLength="50" TextColor="Black"  FontSize="16" ></Entry>

                            <Label Text="SERVICE NUMBER *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Entry x:Name="entry_SERVICENUMBER"   Placeholder="ENTER SERVICE NUMBER" MaxLength="50"  TextColor="Black"  FontSize="16" ></Entry>

                            <Label Text="MEDICAL CATEGORY *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Picker TextColor="Black" TitleColor="Black" Title="SELECT MEDICAL CATEGORY" x:Name="picker_MEDICALCATEGORY" SelectedIndexChanged="picker_MEDICALCATEGORY_SelectedIndexChanged"/>

                            <Label Text="CHARACTER *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Picker TextColor="Black" TitleColor="Black" Title="SELECT CHARACTER" x:Name="picker_CHARACTER" SelectedIndexChanged="picker_CHARACTER_SelectedIndexChanged"/>

                            <Label Text="ENROLMENT DATE *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <StackLayout HorizontalOptions="FillAndExpand" >
                                <Entry TextColor="Black" PlaceholderColor="Black" HorizontalOptions="FillAndExpand"  FontSize="16"  Placeholder="SELECT ENROLMENT DATE" x:Name="Entry_ENROLMENTdate" Focused="Entry_ENROLMENTdate_Focused" />
                                <DatePicker x:Name="datepicker_ENROLMENTdate" IsVisible="false"  Format="dd/MM/yyyy" DateSelected="datepicker_ENROLMENTdate_DateSelected"  HorizontalOptions="FillAndExpand"/>
                            </StackLayout>

                            <Label Text="DISCHARGE DATE *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <StackLayout HorizontalOptions="FillAndExpand" >
                                <Entry TextColor="Black" PlaceholderColor="Black" HorizontalOptions="FillAndExpand"  FontSize="16"  Placeholder="SELECT DISCHARGE DATE" x:Name="Entry_DISCHARGEdate" Focused="Entry_DISCHARGEdate_Focused" />
                                <DatePicker x:Name="datepicker_DISCHARGEdate" IsVisible="false"  Format="dd/MM/yyyy" DateSelected="datepicker_DISCHARGEdate_DateSelected"  HorizontalOptions="FillAndExpand"/>
                            </StackLayout>

                            <Label Text="REASON *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Picker TextColor="Black" TitleColor="Black" Title="SELECT REASON" x:Name="picker_REASON" SelectedIndexChanged="picker_REASON_SelectedIndexChanged"/>


                            <Label Text="REMARKS" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Editor HeightRequest="70" AutoSize="TextChanges"  x:Name="editor_REMARKS" MaxLength="50" Placeholder="ENTER REMARKS" TextColor="Black"  FontSize="16" ></Editor>

                            <Label Text="Ex-Serviceman Document Details" BackgroundColor="Navy" TextColor="White" Padding="5" FontSize="16"  FontAttributes="Bold" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"/>
                            <Frame BorderColor="Navy" CornerRadius="20">
                                <StackLayout>


                                    <Label Text="ISSUE DATE" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                                    <StackLayout HorizontalOptions="FillAndExpand" >
                                        <Entry TextColor="Black" PlaceholderColor="Black" HorizontalOptions="FillAndExpand"  FontSize="16"  Placeholder="SELECT ISSUE DATE" x:Name="Entry_issuedate" Focused="Entry_issuedate_Focused" />
                                        <DatePicker x:Name="datepicker_issuedate" IsVisible="false"  Format="dd/MM/yyyy" DateSelected="datepicker_issuedate_DateSelected"  HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>


                                    <Label Text="VALID UPTO DATE" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                                    <StackLayout HorizontalOptions="FillAndExpand" >
                                        <Entry TextColor="Black" PlaceholderColor="Black" HorizontalOptions="FillAndExpand"  FontSize="16"  Placeholder="SELECT VALID UPTO" x:Name="Entry_VALIDUPTOdate" Focused="Entry_validuptodate_Focused" />
                                        <DatePicker x:Name="datepicker_VALIDUPTOdate" IsVisible="false"  Format="dd/MM/yyyy" DateSelected="datepicker_validupto_DateSelected"  HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>

                                    <Label Text="CERTIFICATE NO" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                                    <Entry x:Name="entry_certificateno"   Placeholder="ENTER CERTIFICATE NO" TextColor="Black"  FontSize="16" ></Entry>


                                    <StackLayout Orientation="Horizontal" >
                                        <Label x:Name="lbl_doc1" Text="Document" TextColor="Navy" FontSize="16" HorizontalOptions="FillAndExpand"  VerticalTextAlignment="Center" FontAttributes="Bold" Padding="5"></Label>
                                        <Label x:Name="lbl_pdf1" IsVisible="false" Text="PDF Uploaded Successfully"  VerticalTextAlignment="Center" ></Label>
                                        <Button x:Name="btn_uploaddoc1" Text="Choose File..." Clicked="btn_uploaddoc1_Clicked"></Button>
                                        <ImageButton IsVisible="false" x:Name="btn_viewdoc" Source="ic_viewpdf.png" Clicked="btn_viewdoc_Clicked" BackgroundColor="Transparent" HeightRequest="45"></ImageButton>
                                    </StackLayout>


                                </StackLayout>
                            </Frame>
                        </StackLayout>
                    </Frame>
                </StackLayout>
            </ScrollView>

            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                <Button IsVisible="false" x:Name="btn_cancel" FontSize="18" Text="Cancel" Margin="0,10,0,10" BackgroundColor="#0072b6" TextColor="White" CornerRadius="15"  HorizontalOptions="FillAndExpand" Clicked="btn_cancel_Clicked" Padding="10"/>
                <!--<Button  x:Name="btn_submit" FontSize="20" Text="Save" Margin="0,10,0,10" BackgroundColor="#058ef2" TextColor="White" CornerRadius="15"  HorizontalOptions="FillAndExpand" Clicked="btn_submit_Clicked" Padding="10" FontAttributes="Bold"/>-->
                <Button  IsVisible="false"  x:Name="btn_next" FontSize="20" Text="Next" Margin="0,10,0,10" BackgroundColor="#058ef2" TextColor="White" CornerRadius="15"  HorizontalOptions="FillAndExpand" Clicked="btn_next_Clicked" Padding="10" FontAttributes="Bold"/>
                <Button  IsVisible="false"  x:Name="btn_submit" FontSize="20" Text="Save &amp; Next" Margin="0,10,0,10" BackgroundColor="#058ef2" TextColor="White" CornerRadius="15"  HorizontalOptions="FillAndExpand" Clicked="btn_submit_Clicked" Padding="10" FontAttributes="Bold"/>

            </StackLayout>
        </StackLayout>

        <ContentView x:Name="Loading_activity" BackgroundColor="#C0808080" Padding="20, 20" IsVisible="false" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Frame BackgroundColor="White" HorizontalOptions="FillAndExpand">
                    <StackLayout Orientation="Horizontal" Margin="6" HorizontalOptions="FillAndExpand">
                        <ActivityIndicator IsVisible="true" IsRunning="true" Margin="5"/>
                        <Label x:Name="lbl_PleaseWait" Text="Please Wait ..." TextColor="Black" FontAttributes="Bold" HorizontalOptions="FillAndExpand" WidthRequest="600" VerticalTextAlignment="Center"/>
                    </StackLayout>
                </Frame>
            </StackLayout>
        </ContentView>
    </Grid>

</ContentPage>
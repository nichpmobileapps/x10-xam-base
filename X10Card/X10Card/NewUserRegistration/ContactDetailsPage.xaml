<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="X10Card.NewUserRegistration.ContactDetailsPage"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core" 
             ios:Page.UseSafeArea="true"  >
    <NavigationPage.TitleView  >
        <StackLayout  Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" >

            <Image Source="ic_himachallogo.png"  HeightRequest="40"  VerticalOptions="CenterAndExpand"/>
            <StackLayout  Orientation="Vertical" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Spacing="0">
                <Label x:Name="lbl_navigation_header1" Style="{StaticResource NavigationLabelColor}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center"
                    Text="Department Of Labour &amp; Employment"  VerticalTextAlignment="Center" />
                <Label x:Name="lbl_navigation_header"  Style="{StaticResource NavigationLabelColor}"  FontSize="13" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />

            </StackLayout>
        </StackLayout>
    </NavigationPage.TitleView>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="ic_home.png" Clicked="ToolbarItem_Clicked" ></ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
        <StackLayout Margin="9">
            <Button x:Name="btn_header" CornerRadius="10"  Text="Contact Details" HorizontalOptions="FillAndExpand"  TextColor="White" BackgroundColor="Navy" FontSize="16" FontAttributes="Bold"/>
            <Label Text="*Fields marked are mandatory" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="Navy" FontSize="14" />

            
                <StackLayout>
                   
                    <Frame  CornerRadius="10"  BorderColor="#058ef2" VerticalOptions="FillAndExpand" >
                    <ScrollView VerticalOptions ="FillAndExpand">
                        <StackLayout  Orientation="Vertical" >

                            
                            <Label Text="ENTER MOBILE NUMBER *" TextColor="Navy" FontSize="16" FontAttributes="Bold" />
                            <Entry x:Name="entry_mobileno" Placeholder="ENTER MOBILE NUMBER" MaxLength="10" Keyboard="Numeric" TextColor="Black"  FontSize="16" ></Entry>

                            <Label Text="ENTER EMAIL-ID *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Entry x:Name="entry_email"   Placeholder="ENTER EMAIL-ID" MaxLength="25" Keyboard="Email" TextColor="Black"  FontSize="16" ></Entry>

                            <Label Text="SELECT DISTRICT *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Picker TextColor="Black" TitleColor="Black" Title="SELECT DISTRICT" x:Name="picker_district" SelectedIndexChanged="picker_district_SelectedIndexChanged"/>

                            <Label Text="SELECT AREA TYPE *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <StackLayout Orientation="Horizontal">
                                <RadioButton x:Name="rd_RURAL" Content="RURAL" GroupName="areatypegroup" TextColor="Navy"  FontAttributes="Bold" FontSize="16" IsChecked="True" CheckedChanged="rd_RURAL_CheckedChanged"/>
                                <RadioButton x:Name="rd_URBAN" Content="URBAN" GroupName="areatypegroup" TextColor="Navy"  FontAttributes="Bold" FontSize="16" CheckedChanged="rd_RURAL_CheckedChanged"/>
                            </StackLayout>

                            <Label Text="SELECT TEHSIL *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Picker TextColor="Black" TitleColor="Black" Title="SELECT TEHSIL NAME " x:Name="picker_tehsil" SelectedIndexChanged="picker_tehsil_SelectedIndexChanged"/>

                            <Label Text="SELECT VILLAGE *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Editor Placeholder="Tap To Select Village Name" x:Name="editor_VillageName" PlaceholderColor="Black" HeightRequest="70" Focused="editor_VillageName_Focused" AutoSize="TextChanges" FontSize="16"  />

                            <!--<Picker TextColor="Black" TitleColor="Black" Title="SELECT VILLAGE NAME " x:Name="picker_village" SelectedIndexChanged="picker_village_SelectedIndexChanged"/>-->

                            <Label Text="ENTER POST OFFICE *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Entry x:Name="entry_PO" MaxLength="50" Placeholder="ENTER POST OFFICE" TextColor="Black"  FontSize="16" ></Entry>

                            <Label Text="ENTER STREET BUILDING" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Editor HeightRequest="70" AutoSize="TextChanges"  x:Name="editor_streetbuilding" MaxLength="50" Placeholder="ENTER STREET BUILDING" TextColor="Black"  FontSize="16" ></Editor>

                            <Label Text="ENTER PINCODE *" TextColor="Navy" FontSize="16" FontAttributes="Bold" />
                            <Entry x:Name="entry_pincode" Placeholder="ENTER PINCODE" MaxLength="6" Keyboard="Numeric" TextColor="Black"  FontSize="16" ></Entry>

                            <Label Text="ENTER ALTERNATE PHONE NUMBER" TextColor="Navy" FontSize="16" FontAttributes="Bold" />
                            <Entry x:Name="entry_phoneno" Placeholder="ENTER ALTERNATE PHONE NUMBER" MaxLength="12" Keyboard="Numeric" TextColor="Black"  FontSize="16" ></Entry>

                            <Label Text="ENTER PERMANENT ADDRESS *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Editor HeightRequest="70" AutoSize="TextChanges"  x:Name="editor_permanentaddress" MaxLength="50" Placeholder="ENTER PERMANENT ADDRESS" TextColor="Black"  FontSize="16" />
                          
                            <StackLayout Orientation="Horizontal">
                                <CheckBox x:Name="chkbx_address" CheckedChanged="chkbx_address_CheckedChanged"/>
                                <Label Text="SAME AS PERMANENT ADDRESS" VerticalOptions="Center"  TextColor="Navy" FontSize="16"/>
                            </StackLayout>

                            <Label Text="ENTER CORRESPONDENCE ADDRESS *" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                            <Editor HeightRequest="70" AutoSize="TextChanges"  x:Name="editor_corresponsenceaddress" MaxLength="50" Placeholder="ENTER CORRESPONDENCE ADDRESS" TextColor="Black"  FontSize="16" />
                            
                            <Label Text="Address Proof Document Details" BackgroundColor="Navy" TextColor="White" Padding="5" FontSize="16"  FontAttributes="Bold" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"/>
                            <Frame BorderColor="Navy" CornerRadius="20">
                                <StackLayout>


                                    <Label Text="SELECT ISSUE DATE" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                                    <StackLayout HorizontalOptions="FillAndExpand" >
                                        <Entry TextColor="Black" PlaceholderColor="Black" HorizontalOptions="FillAndExpand"  FontSize="16"  Placeholder="SELECT ISSUE DATE" x:Name="Entry_issuedate" Focused="Entry_issuedate_Focused" />
                                        <DatePicker x:Name="datepicker_issuedate" IsVisible="false"  Format="dd/MM/yyyy" DateSelected="datepicker_issuedate_DateSelected"  HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>

                                    <Label Text="ENTER CERTIFICATE NO" TextColor="Navy" FontSize="16"  FontAttributes="Bold" />
                                    <Entry x:Name="entry_certificateno"   Placeholder="ENTER CERTIFICATE NO" TextColor="Black"  FontSize="16" ></Entry>


                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                                        <Label x:Name="lbl_doc1" Text="DOCUMENT" TextColor="Navy" FontSize="16" HorizontalOptions="FillAndExpand"  VerticalTextAlignment="Center" FontAttributes="Bold" Padding="5"></Label>
                                        <Label x:Name="lbl_pdf1" IsVisible="false" Text="PDF Uploaded Successfully"  VerticalTextAlignment="Center" ></Label>
                                        <Button x:Name="btn_uploaddoc1" Text="Choose File..." Clicked="btn_uploaddoc1_Clicked" />
                                        <ImageButton IsVisible="false" x:Name="btn_viewdoc" Source="ic_viewpdf.png" Clicked="btn_viewdoc_Clicked" HeightRequest="45" BackgroundColor="Transparent"/>

                                    </StackLayout>
                                    

                                </StackLayout>
                            </Frame>
                        </StackLayout>
                    </ScrollView>
                </Frame>
                </StackLayout>
           

            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                <Button IsVisible="false"  x:Name="btn_cancel" FontSize="18" Text="Cancel" Margin="0,10,0,10" BackgroundColor="#0072b6" TextColor="White" CornerRadius="15"  HorizontalOptions="FillAndExpand" Clicked="btn_cancel_Clicked" Padding="10"/>
                <Button  IsVisible="false"  x:Name="btn_next" FontSize="20" Text="Next" Margin="0,10,0,10" BackgroundColor="#058ef2" TextColor="White" CornerRadius="15"  HorizontalOptions="FillAndExpand" Clicked="btn_next_Clicked" Padding="10" FontAttributes="Bold"/>
                <Button  IsVisible="false"  x:Name="btn_submit" FontSize="20" Text="Save &amp; Next" Margin="0,10,0,10" BackgroundColor="#058ef2" TextColor="White" CornerRadius="15"  HorizontalOptions="FillAndExpand" Clicked="btn_submit_Clicked" Padding="10" FontAttributes="Bold"/>
            </StackLayout>
        </StackLayout>


        <ContentView x:Name="popupvillagename" BackgroundColor="#C0808080" Padding="20" IsVisible="false" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All">
            <StackLayout HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="white">
                <Label x:Name="lbl_popupvillagename" Text="Tap To Select village Name" Padding="6" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="16" FontAttributes="Bold" TextColor="Navy" />
                <Frame  Padding="0" Margin="3" CornerRadius="20" BorderColor="Navy">
                    <SearchBar Placeholder="Type village Name" x:Name="SearchBar_villagename" IsSpellCheckEnabled="False" PlaceholderColor="#736f6f" BackgroundColor="#e0e0e0" TextColor="Black"  CancelButtonColor="Red"  Keyboard="Plain" TextChanged="SearchBar_villagename_TextChanged"/>
                </Frame>

                <ListView x:Name="listview_villagename" HasUnevenRows="True" SeparatorColor="Navy" ItemTapped="listview_villagename_ItemTapped" BackgroundColor="White">
                    <ListView.ItemTemplate >
                        <DataTemplate>
                            <ViewCell>
                                <StackLayout Orientation="Vertical" Grid.Row="0">
                                    <Label Text="{Binding VillageName}" HorizontalOptions="FillAndExpand" Padding="10" HorizontalTextAlignment="Start" TextColor="Black"/>
                                </StackLayout>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button BackgroundColor="Navy" TextColor="White" FontAttributes="Bold"  x:Name="popupvillagenameCancel" Clicked="popupvillagenameCancel_Clicked" Text="Cancel" Margin="5" HorizontalOptions="FillAndExpand"/>
            </StackLayout>
        </ContentView>

        <ContentView x:Name="Loading_activity" BackgroundColor="#C0808080" Padding="20, 20" IsVisible="false" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Frame BackgroundColor="White" HorizontalOptions="FillAndExpand">
                    <StackLayout Orientation="Horizontal" Margin="6" HorizontalOptions="FillAndExpand">
                        <ActivityIndicator IsVisible="true" IsRunning="true" Margin="5"/>
                        <Label x:Name="lbl_PleaseWait" Text="Please Wait ..." TextColor="Black" FontAttributes="Bold" HorizontalOptions="FillAndExpand" WidthRequest="600" VerticalTextAlignment="Center"/>
                    </StackLayout>
                </Frame>
            </StackLayout>
        </ContentView>
    </Grid>

</ContentPage>